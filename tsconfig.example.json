{
  "compilerOptions": {
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "module": "ESNext",
    "verbatimModuleSyntax": true,
    "strict": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "lib": ["es2022", "dom"],
    "types": ["vite/client"]
  },
  "include": ["example/**/*", "src/**/*"]
}
